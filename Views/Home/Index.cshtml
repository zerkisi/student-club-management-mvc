@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid bg-dark text-white py-5">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-md-7">

                <span class="badge bg-primary mb-3">
                    ASP.NET MVC Project
                </span>

                <h1 class="display-4 fw-bold">
                    CampusHub Student Club Management System
                </h1>

                <p class="lead mt-3">
                    Manage university clubs, activities and student registrations using ASP.NET Core MVC.
                </p>

                <a href="/Home/Register" class="btn btn-light btn-lg mt-3">
                    Register Now
                </a>

                <a href="/Home/Clubs" class="btn btn-outline-light btn-lg mt-3 ms-2">
                    View Clubs
                </a>

            </div>

            <div class="col-md-5 mt-4 mt-md-0">

                <div class="card shadow">

                    <div class="card-body text-dark">

                        <h4 class="mb-3">
                            Project Features
                        </h4>

                        <ul class="list-group">

                            <li class="list-group-item">
                                ASP.NET Core MVC Architecture
                            </li>

                            <li class="list-group-item">
                                Bootstrap Responsive Design
                            </li>

                            <li class="list-group-item">
                                Student Management System
                            </li>

                            <li class="list-group-item">
                                Activity Registration
                            </li>

                            <li class="list-group-item">
                                JavaScript Form Validation
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="container mt-5">

    <h2 class="text-center mb-5">
        Dashboard Overview
    </h2>

    <div class="row">

        <div class="col-md-3 mb-4">

            <div class="card shadow text-center">

                <div class="card-body">

                    <h5>Total Clubs</h5>

                    <h2 class="text-primary">
                        12
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow text-center">

                <div class="card-body">

                    <h5>Total Students</h5>

                    <h2 class="text-success">
                        350
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow text-center">

                <div class="card-body">

                    <h5>Activities</h5>

                    <h2 class="text-danger">
                        8
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow text-center">

                <div class="card-body">

                    <h5>Departments</h5>

                    <h2 class="text-warning">
                        5
                    </h2>

                </div>

            </div>

        </div>

    </div>

</div>